# Create a dedicated Discord bot. Never use a user account token.
DISCORD_BOT_TOKEN=

# Comma-separated guild IDs. Every tool call is rejected outside this list.
DISCORD_ALLOWED_GUILD_IDS=
# Optional. Direct-message tools remain disabled unless recipient IDs are explicitly allowlisted.
DISCORD_ALLOWED_USER_IDS=

# read-only | safe-write | full
DISCORD_MODE=read-only

# Destructive tools additionally require mode=full and a one-time per-call confirmation.
DISCORD_ENABLE_DESTRUCTIVE=false

# Dry-run confirmations expire after this many seconds and are consumed on first use (30-3600).
DISCORD_CONFIRMATION_TTL_SECONDS=300

# Each Discord network attempt is bounded; transient timeouts and 5xx responses are retried by @discordjs/rest.
# Timeout: 1000-60000 ms. Retries: 0-5.
DISCORD_REQUEST_TIMEOUT_MS=15000
DISCORD_REQUEST_RETRIES=3

# Guardrail for blueprint runs.
DISCORD_MAX_BULK_ACTIONS=100

# Stored locally and never sent to Discord.
DISCORD_STATE_FILE=.data/state.json

# Appears in Discord's audit log when the endpoint supports reasons.
DISCORD_AUDIT_REASON_PREFIX=TheeDiscordMCP
