{
  "name": "thee-discord-mcp",
  "version": "0.1.0",
  "description": "A safety-gated MCP server for managing Discord guilds through the official REST API.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "discord",
    "discord-api",
    "server-administration",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheETR/Thee-Discord-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/TheETR/Thee-Discord-MCP/issues"
  },
  "homepage": "https://github.com/TheETR/Thee-Discord-MCP#readme",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs",
    "examples",
    ".env.example",
    "mcp.config.example.toml"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "thee-discord-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "inventory:write": "node scripts/smoke.mjs --write",
    "inventory:check": "node scripts/smoke.mjs --check",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm inventory:check",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "discord-api-types": "^0.38.53",
    "dotenv": "^17.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.10.0"
}
